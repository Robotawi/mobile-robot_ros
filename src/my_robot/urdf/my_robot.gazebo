<?xml version="1.0"?>
<robot>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <!-- wheels -->
      <left_joint>left_wheel_hinge</left_joint>
      <right_joint>right_wheel_hinge</right_joint>

      <!-- kinematics -->
      <wheel_separation>0.4</wheel_separation>
      <wheel_radius>0.1</wheel_radius>

      <!-- limits -->
      <max_linear_acceleration>0.033</max_linear_acceleration>

      <topic>cmd_vel</topic>

      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>robot_footprint</child_frame_id>
      <odom_publisher_frequency>10</odom_publisher_frequency>

      <tf_topic>/tf</tf_topic>

    </plugin>
  </gazebo>

  <!-- camera -->
  <gazebo reference="camera">
    <sensor type="camera" name="camera1">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30.0</update_rate>
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera</gz_frame_id>
      <camera name="main">
        <camera_info_topic>camera/camera_info</camera_info_topic>
        <image>
          <width>800</width>
          <height>800</height>
          <format>R8G8B8</format>
        </image>
      </camera>
    </sensor>
  </gazebo>

  <!-- hokuyo -->
  <gazebo reference="hokuyo">
    <sensor name="hokuyo_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <pose>0 0 0 0 0 0</pose>
      <update_rate>5</update_rate>
      <topic>scan</topic>
      <gz_frame_id>hokuyo</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.000000</resolution>
            <min_angle>0.000000</min_angle>
            <max_angle>6.280000</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
</robot>